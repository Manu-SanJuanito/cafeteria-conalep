# Copia este archivo como ".env" para probar variables de producción en tu compu,
# O configura estas mismas variables directamente en el panel de Railway/Render.
# NUNCA subas un archivo ".env" real (con valores verdaderos) a GitHub.

# Genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-nueva-y-secreta

DEBUG=False

# Dominio(s) que te da Railway/Render, separados por coma (sin http:// ni la barra final)
ALLOWED_HOSTS=tu-app.up.railway.app

# URL de tu frontend en Vercel/Netlify, separadas por coma (con https://, sin barra final)
CORS_ALLOWED_ORIGINS=https://tu-cafeteria.vercel.app

# Railway/Render la definen solos al conectar una base PostgreSQL; no la escribas a mano.
# DATABASE_URL=postgres://usuario:password@host:puerto/nombre_db
